# Cloudflare R2 credentials — required for syncing snapshots to object storage.
# Copy this file to .env and fill in your values.
# Generate S3-compatible credentials from: Cloudflare Dashboard → R2 → Manage → R2 API Tokens

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: bucket name (defaults to "public-record-archive")
R2_BUCKET=public-record-archive
